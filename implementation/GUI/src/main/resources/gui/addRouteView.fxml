<AnchorPane prefHeight="399.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(#FFFAEF,#FFFFFF);" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.RouteController">
   <children>
      <Label layoutX="28.0" layoutY="20.0" text="Add Route" />
      <Label layoutX="300.0" layoutY="88.0" text="Destination" />
      <Label layoutX="28.0" layoutY="88.0" text="Origin" />
      <ComboBox fx:id="modelDropDownOrigin" layoutX="28.0" layoutY="105.0" onAction="#updateDestination" prefWidth="150.0" />
      <ComboBox fx:id="modelDropDownDestination" layoutX="300.0" layoutY="106.0" onAction="#updateOrigin" prefWidth="150.0" />
      <Button layoutX="511.0" layoutY="327.0" mnemonicParsing="false" onAction="#toSecondary" text="Home" />
      <Button layoutX="511.0" layoutY="360.0" mnemonicParsing="false" onAction="#storeRoute" text="Save" />
      <Label fx:id="result" layoutX="13.0" layoutY="365.0" />
      <Label fx:id="l" layoutX="483.0" layoutY="181.0" underline="true" />
   </children>
