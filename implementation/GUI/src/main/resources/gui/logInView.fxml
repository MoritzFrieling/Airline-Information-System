<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="440.0" prefWidth="640.0" styleClass="app-shell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.LogInController">
   <children>
      <VBox layoutX="128.0" layoutY="70.0" prefWidth="384.0" spacing="10.0" styleClass="card">
         <children>
            <Label styleClass="eyebrow" text="AIRLINE INFORMATION SYSTEM" />
            <Label styleClass="page-title" text="Welcome back" />
            <Label styleClass="page-subtitle" text="Sign in to manage flights, routes and airport data." wrapText="true" />
            <Label text="E-mail" />
            <TextField fx:id="eMailField" promptText="name@example.com" />
            <Label text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#logIn" styleClass="primary-button" text="Log in" />
            <Label fx:id="label" minHeight="18.0" styleClass="status-label" />
            <Label styleClass="muted-label" text="Demo access: dev (leave password empty)" />
         </children>
         <padding>
            <Insets bottom="22.0" left="26.0" right="26.0" top="22.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
