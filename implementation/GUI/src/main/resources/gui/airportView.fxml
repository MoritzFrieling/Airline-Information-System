<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(#FFFAEF,#FFFFFF);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AirportController">
   <children>
      <Button fx:id="toSecondaryButton" layoutX="506.0" layoutY="360.0" mnemonicParsing="false" onAction="#toSecondary" style="-fx-background-color: linear-gradient(#ff5400, #be1d00); -fx-background-radius: 30; -fx-background-insets: 0; -fx-text-fill: white;" text="Home" />
      <Label fx:id="result" layoutX="38.0" layoutY="309.0" prefHeight="71.0" prefWidth="444.0" text="" wrapText="true" />
      <VBox layoutX="170.0" layoutY="37.0" prefHeight="230.0" prefWidth="260.0" spacing="10.0">
         <children>
            <HBox prefHeight="30.0" prefWidth="250.0">
               <children>
                  <Label prefWidth="74.0" text="Airport Name" />
                  <TextField fx:id="airportName" />
               </children>
            </HBox>
            <HBox prefHeight="30.0" prefWidth="250.0">
               <children>
                  <Label prefHeight="18.0" prefWidth="74.0" text="Abbreviation" />
                  <TextField fx:id="abbreviationName" />
               </children>
            </HBox>
            <HBox prefHeight="30.0" prefWidth="242.0">
               <children>
                  <Label prefWidth="74.0" text="Country" />
                  <TextField fx:id="countryName" />
               </children>
            </HBox>
            <HBox prefHeight="30.0" prefWidth="274.0">
               <children>
                  <Label prefWidth="74.0" text="City" />
                  <TextField fx:id="cityName" />
               </children>
            </HBox>
            <HBox prefHeight="30.0" prefWidth="261.0">
               <children>
                  <Label prefWidth="74.0" text="Coordinate" />
                  <TextField fx:id="coordinate" />
               </children>
            </HBox>
            <HBox prefHeight="26.0" prefWidth="250.0" spacing="25.0">
               <children>
                  <Button fx:id="checkAirports" mnemonicParsing="false" onAction="#checkAirports" prefHeight="26.0" prefWidth="114.0" style="-fx-background-radius: 30; -fx-background-color: linear-gradient(#ff5400, #be1d00); -fx-text-fill: white; -fx-background-insets: 0;" text="Check Airports" />
                  <Button fx:id="saveButton" mnemonicParsing="false" onAction="#storeAirport" prefHeight="26.0" prefWidth="104.0" style="-fx-background-color: linear-gradient(#ff5400, #be1d00); -fx-background-radius: 30; -fx-background-insets: 0; -fx-text-fill: white;" text="Save Airport" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
