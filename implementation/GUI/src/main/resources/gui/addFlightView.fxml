<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="399.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.FlightController">
   <children>
       <Label layoutX="28.0" layoutY="20.0" text="Add Flight" />

       <!--Origin city dropDown -->
       <Label layoutX="44.0" layoutY="52.0" text="Origin" />
       <ComboBox fx:id="modelDropDownOrigin" layoutX="44.0" layoutY="69.0" prefHeight="25.0" prefWidth="166.0" />

       <!-- Destination city dropDown -->
       <Label layoutX="300.0" layoutY="52.0" text="Destination" />
       <ComboBox fx:id="modelDropDownDestination" layoutX="300.0" layoutY="69.0" prefHeight="25.0" prefWidth="166.0" />

       <!-- Departure date datePicker -->
       <Label layoutX="300.0" layoutY="120.0" text="Departure date" />
       <DatePicker fx:id="datePickerDeparture" layoutX="300.0" layoutY="139.0" prefHeight="25.0" prefWidth="166.0" />

       <!-- Plane dropDown -->
       <Label fx:id="planeLabel" layoutX="46.0" layoutY="182.0" text="Plane" />
       <ComboBox fx:id="modelDropDownPlane" layoutX="44.0" layoutY="199.0" prefHeight="25.0" prefWidth="166.0" />

       <!-- Duration in minutes to determine arrival Date (temporary)
       later the arrival date gets calculated by speed of plane and distance -->
       <Label layoutX="44.0" layoutY="120.0" text="Duration (Minutes)" />
       <TextField fx:id="durationMinutes" layoutX="44.0" layoutY="139.0" prefHeight="25.0" prefWidth="166.0" />

       <!-- Result of picked options -->
       <Label fx:id="result" layoutX="13.0" layoutY="335.0">
         <font>
            <Font size="15.0" />
         </font></Label>

       <!-- Navigation buttons home and back -->
       <Button layoutX="508.0" layoutY="339.0" mnemonicParsing="false" onAction="#toSecondary" text="Home" />
       <Button layoutX="508.0" layoutY="303.0" mnemonicParsing="false" onAction="#goFlightOptions" prefHeight="25.0" prefWidth="49.0" text="Back" />

       <!-- Save button to save the flight -->
       <Button layoutX="299.0" layoutY="259.0" mnemonicParsing="false" onAction="#storeFlight" prefHeight="25.0" prefWidth="166.0" text="Save" />

       <!-- DepartureTime field -->
       <TextField fx:id="departureTime" layoutX="298.0" layoutY="199.0" prefHeight="25.0" prefWidth="166.0" />
       <Label layoutX="300.0" layoutY="182.0" text="Departure time ('Hours:Minutes')" />

       <!-- defaultPrice field -->
       <TextField fx:id="defaultFlightPrice" layoutX="44.0" layoutY="259.0" prefHeight="25.0" prefWidth="166.0" />
       <Label layoutX="45.0" layoutY="241.0" text="Price (cent)" />

   </children>
</AnchorPane>
