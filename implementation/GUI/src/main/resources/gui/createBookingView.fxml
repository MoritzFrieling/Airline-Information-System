<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox layoutX="-1.0" layoutY="236.0" prefHeight="167.0" prefWidth="642.0">
               <children>
                  <TableView prefHeight="169.0" prefWidth="642.0" />
               </children>
            </HBox>
            <HBox layoutX="14.0" layoutY="14.0" prefHeight="44.0" prefWidth="625.0" spacing="25.0">
               <children>
                  <HBox prefHeight="35.0" prefWidth="225.0">
                     <children>
                        <Label prefWidth="85.0" text="Origin" />
                        <TextField>
                           <contextMenu>
                              <ContextMenu>
                                <items>
                                  <MenuItem mnemonicParsing="false" text="Unspecified Action" />
                                </items>
                              </ContextMenu>
                           </contextMenu>
                        </TextField>
                     </children>
                  </HBox>
                  <HBox prefHeight="35.0" prefWidth="225.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="85.0" text="Destination" />
                        <TextField>
                           <contextMenu>
                              <ContextMenu>
                                <items>
                                  <MenuItem mnemonicParsing="false" text="Unspecified Action" />
                                </items>
                              </ContextMenu>
                           </contextMenu>
                        </TextField>
                     </children>
                  </HBox>
                  <Label fx:id="feedbackRoute" prefHeight="18.0" prefWidth="63.0" />
               </children>
            </HBox>
            <VBox layoutX="14.0" layoutY="98.0" prefHeight="138.0" prefWidth="180.0" spacing="25.0">
               <children>
                  <ChoiceBox fx:id="classPick" prefWidth="150.0" />
                  <ChoiceBox fx:id="rowPick" prefWidth="150.0" />
                  <ChoiceBox fx:id="seatPick" prefWidth="150.0" />
               </children>
            </VBox>
            <Label layoutX="14.0" layoutY="80.0" text="SEAT" />
            <VBox layoutX="174.0" layoutY="98.0" prefHeight="70.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <RadioButton mnemonicParsing="false" text="Premium" />
                  <RadioButton mnemonicParsing="false" text="Basic" />
                  <RadioButton mnemonicParsing="false" text="none" />
               </children>
            </VBox>
            <Label layoutX="174.0" layoutY="80.0" text="FOOD" />
            <Label layoutX="274.0" layoutY="80.0" text="PERSONAL INFO" />
            <VBox layoutX="274.0" layoutY="98.0" prefHeight="138.0" prefWidth="226.0">
               <children>
                  <HBox prefHeight="32.0" prefWidth="200.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="55.0" text="Firstname" />
                        <TextField />
                     </children>
                  </HBox>
                  <HBox prefHeight="32.0" prefWidth="200.0">
                     <children>
                        <Label prefWidth="55.0" text="Lastname" />
                        <TextField />
                     </children>
                  </HBox>
                  <HBox prefHeight="32.0" prefWidth="200.0">
                     <children>
                        <Label prefWidth="55.0" text="Birthday" />
                        <DatePicker />
                     </children>
                  </HBox>
                  <HBox prefHeight="32.0" prefWidth="200.0" spacing="20.0">
                     <children>
                        <RadioButton mnemonicParsing="false" text="male" />
                        <RadioButton mnemonicParsing="false" text="female" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="55.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <Button layoutX="551.0" layoutY="122.0" mnemonicParsing="false" text="Add Ticket" />
            <Button layoutX="544.0" layoutY="167.0" mnemonicParsing="false" text="Save Booking" />
         </children>
    </AnchorPane>
  </children>
</VBox>
